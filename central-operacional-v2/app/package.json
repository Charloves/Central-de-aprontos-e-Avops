{
  "name": "central-operacional-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import:dry-run": "node --experimental-strip-types scripts/import-dry-run.ts --efetivo fixtures/import/efetivo.csv --avops fixtures/import/avops.csv --leituras fixtures/import/leituras.csv --aprontos fixtures/import/aprontos.csv --presencas fixtures/import/presencas.csv --oi-h50 fixtures/import/oi_h50.csv --oi-h125 fixtures/import/oi_h125.csv --email-log fixtures/import/email_log.csv --acessos-log fixtures/import/acessos_log.csv",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:version": "supabase --version",
    "supabase:migrations:list": "node --experimental-strip-types scripts/supabase-migrations-list.ts",
    "supabase:db:push:dry-run": "node --experimental-strip-types scripts/safe-supabase-dry-run.ts",
    "supabase:types:dev": "node --experimental-strip-types scripts/generate-supabase-types.ts",
    "supabase:validate:dev": "node --experimental-strip-types scripts/validate-supabase-dev.ts",
    "gmail:oauth:check": "node --experimental-strip-types scripts/gmail-oauth-local.ts --check",
    "gmail:oauth:local": "node --experimental-strip-types scripts/gmail-oauth-local.ts --authorize",
    "gmail:test:send": "node --conditions=react-server --experimental-strip-types scripts/gmail-test-send.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "googleapis": "173.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.5.22",
    "supabase": "2.111.0",
    "typescript": "^5.6.2",
    "vitest": "3.2.6"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true
  }
}
